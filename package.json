{
  "name": "agentsession-workspace",
  "version": "3.0.0-rc.2",
  "description": "AgentSession — a local-first multi-provider viewer and manager for AI coding sessions.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/v3-workspace.mjs build",
    "test": "node scripts/v3-workspace.mjs test",
    "start": "node scripts/v3-workspace.mjs start",
    "dev": "node scripts/v3-workspace.mjs dev",
    "typecheck": "cargo check --manifest-path v3/Cargo.toml --workspace --locked",
    "check:governance": "node scripts/verify-governance.mjs",
    "review": "npm run check:governance && cargo fmt --manifest-path v3/Cargo.toml --all -- --check && npm run typecheck",
    "pre-push": "npm run review",
    "ci:quality": "npm run review && npm test"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "keywords": [
    "agentsession",
    "agent-session",
    "opencode",
    "claude-code",
    "codex",
    "pi-coding-agent",
    "deepseek-harness",
    "session-viewer",
    "ai-coding",
    "session-manager",
    "cli"
  ],
  "author": "Guanzhw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guanzhw/AgentSession.git"
  },
  "homepage": "https://github.com/Guanzhw/AgentSession",
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  }
}

    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List provider-recorded queued team messages for a session, then read exact-revision content in bounded pages. This native mailbox evidence is separate from conversation events.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "action": { "enum": ["list", "read"], "type": "string" },
          "session": {
            "additionalProperties": false,
            "properties": {
              "provider": { "enum": ["opencode", "claude-code", "codex", "pi", "deepseek-harness"], "type": "string" },
              "sessionId": { "minLength": 1, "maxLength": 1000, "type": "string" }
            },
            "required": ["provider", "sessionId"],
            "type": "object"
          },
          "message": {
            "additionalProperties": false,
            "properties": {
              "provider": { "enum": ["opencode", "claude-code", "codex", "pi", "deepseek-harness"], "type": "string" },
              "sessionId": { "minLength": 1, "maxLength": 1000, "type": "string" },
              "sourceId": { "minLength": 1, "maxLength": 1000, "type": "string" },
              "messageId": { "minLength": 1, "maxLength": 1000, "type": "string" }
            },
            "required": ["provider", "sessionId", "sourceId", "messageId"],
            "type": "object"
          },
          "revision": { "minLength": 1, "type": "string" },
          "limit": { "exclusiveMinimum": 0, "maximum": 100, "type": "integer" },
          "cursor": { "minLength": 1, "type": "string" },
          "offset": { "minimum": 0, "maximum": 9007199254740991, "type": "integer" },
          "maxChars": { "exclusiveMinimum": 0, "maximum": 20000, "type": "integer" }
        },
        "oneOf": [
          {
            "properties": { "action": { "const": "list" } },
            "required": ["action", "session"],
            "not": {
              "anyOf": [
                { "required": ["message"] },
                { "required": ["revision"] },
                { "required": ["offset"] },
                { "required": ["maxChars"] }
              ]
            }
          },
          {
            "properties": { "action": { "const": "read" } },
            "required": ["action", "message", "revision"],
            "not": {
              "anyOf": [
                { "required": ["session"] },
                { "required": ["limit"] },
                { "required": ["cursor"] }
              ]
            }
          }
        ],
        "required": ["action"],
        "type": "object"
      },
      "name": "session_team_messages",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "result": {},
          "untrustedContent": { "const": true, "type": "boolean" }
        },
        "required": ["result", "untrustedContent"],
        "type": "object"
      }
